# Public site URL encoded in QR codes. Production requires your real https domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Postgres connection used by the server. Production requires TLS.
DATABASE_URL="postgresql://postgres.your-project:your-password@your-region.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"

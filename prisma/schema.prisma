datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  SHOP_STAFF
  CUSTOMER

  @@map("user_role")
}

enum ShopMemberRole {
  OWNER
  STAFF

  @@map("shop_member_role")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(SHOP_OWNER)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownedShops  Shop[]       @relation("ShopOwner")
  memberships ShopMember[]
  auditLogs   AuditLog[]

  @@map("profiles")
}

model Shop {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerId               String   @map("owner_id") @db.Uuid
  name                  String
  slug                  String   @unique
  description           String?
  businessCategory      String   @map("business_category")
  address               String?
  phone                 String?
  logoUrl               String?  @map("logo_url")
  websiteUrl            String?  @map("website_url")
  primaryColor          String   @default("#4F46E5") @map("primary_color")
  surfaceColor          String?  @map("surface_color")
  accentColor           String?  @map("accent_color")
  googleReviewUrl       String   @map("google_review_url")
  verifiedBusinessFacts Json     @default("[]") @map("verified_business_facts")
  defaultLanguage       String   @default("en") @map("default_language")
  defaultAiProvider     String   @default("gemini") @map("default_ai_provider")
  isActive              Boolean  @default(true) @map("is_active")
  subscriptionEndsAt    DateTime @default(dbgenerated("(now() + '1 year'::interval)")) @map("subscription_ends_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  owner           Profile          @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members         ShopMember[]
  qrCodes         QrCode[]
  chips           ReviewChip[]
  reviewSessions  ReviewSession[]
  reviewDrafts    ReviewDraft[]
  reviewFeedback  ReviewFeedback[]
  analyticsEvents AnalyticsEvent[]
  aiUsageLogs     AiUsageLog[]
  subscription    Subscription?
  auditLogs       AuditLog[]
  payments        ShopPayment[]

  @@index([ownerId])
  @@index([slug])
  @@index([subscriptionEndsAt], map: "shops_subscription_ends_at_idx")
  @@map("shops")
}

model ShopMember {
  id        String         @id @default(uuid()) @db.Uuid
  shopId    String         @map("shop_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      ShopMemberRole @default(STAFF)
  createdAt DateTime       @default(now()) @map("created_at")

  shop Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
  @@index([shopId])
  @@map("shop_members")
}

model QrCode {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  name           String
  publicToken    String   @unique @map("public_token")
  destinationUrl String   @map("destination_url")
  qrImagePath    String?  @map("qr_image_path")
  scanCount      Int      @default(0) @map("scan_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewSessions  ReviewSession[]
  analyticsEvents AnalyticsEvent[]

  @@index([publicToken])
  @@index([shopId])
  @@map("qr_codes")
}

model ReviewChip {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, label])
  @@index([shopId, isActive, sortOrder])
  @@map("review_chips")
}

model ReviewSession {
  id                 String   @id @default(uuid()) @db.Uuid
  shopId             String   @map("shop_id") @db.Uuid
  qrCodeId           String?  @map("qr_code_id") @db.Uuid
  anonymousSessionId String   @map("anonymous_session_id")
  language           String   @default("en")
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  qrCode          QrCode?          @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  drafts          ReviewDraft[]
  feedback        ReviewFeedback?
  analyticsEvents AnalyticsEvent[]
  aiUsageLogs     AiUsageLog[]

  @@index([shopId])
  @@index([qrCodeId])
  @@index([anonymousSessionId])
  @@map("review_sessions")
}

model ReviewDraft {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  customerNotes String?  @map("customer_notes")
  generatedText String   @map("generated_text")
  editedText    String?  @map("edited_text")
  provider      String
  model         String?
  language      String   @default("en")
  style         String   @default("natural")
  isCopied      Boolean  @default(false) @map("is_copied")
  createdAt     DateTime @default(now()) @map("created_at")

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop    Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([shopId])
  @@map("review_drafts")
}

model ReviewFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @unique @map("session_id") @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  rating     Int
  message    String?
  status     String    @default("OPEN")
  ownerNote  String?   @map("owner_note")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop    Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("review_feedback")
}

model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  qrCodeId  String?  @map("qr_code_id") @db.Uuid
  sessionId String?  @map("session_id") @db.Uuid
  eventType String   @map("event_type")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  qrCode  QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  session ReviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([shopId, eventType])
  @@index([createdAt])
  @@index([qrCodeId])
  @@map("analytics_events")
}

model AiUsageLog {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  provider      String
  model         String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  estimatedCost Decimal  @default(0.0) @map("estimated_cost") @db.Decimal(10, 6)
  status        String   @default("SUCCESS")
  errorMessage  String?  @map("error_message")
  latencyMs     Int      @default(0) @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  shop    Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  session ReviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model Plan {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  code                    String   @unique
  description             String?
  priceMonthly            Decimal  @default(0.0) @map("price_monthly") @db.Decimal(10, 2)
  maxQrCodes              Int      @default(1) @map("max_qr_codes")
  maxMonthlyAiGenerations Int      @default(100) @map("max_monthly_ai_generations")
  allowedAiProviders      String[] @default(["gemini", "openai"]) @map("allowed_ai_providers")
  customBranding          Boolean  @default(false) @map("custom_branding")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  shopId    String             @unique @map("shop_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now()) @map("start_date")
  endDate   DateTime?          @map("end_date")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@index([planId])
  @@map("subscriptions")
}

model AiProviderSetting {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @unique
  isEnabled         Boolean   @default(true) @map("is_enabled")
  defaultModel      String    @map("default_model")
  availableModels   String[]  @default([]) @map("available_models")
  rpmLimit          Int       @default(60) @map("rpm_limit")
  tpmLimit          Int       @default(100000) @map("tpm_limit")
  isFallbackEnabled Boolean   @default(true) @map("is_fallback_enabled")
  fallbackPriority  Int       @default(1) @map("fallback_priority")
  isHealthy         Boolean   @default(true) @map("is_healthy")
  lastCheckedAt     DateTime? @map("last_checked_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("ai_provider_settings")
}

model PosterPricing {
  id          Int      @id @default(1)
  normalPrice Int      @default(1999) @map("normal_price")
  customPrice Int      @default(2250) @map("custom_price")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("poster_pricing")
}

model PosterCoupon {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  amountOff Int      @map("amount_off")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("poster_coupons")
}

model OrderingSettings {
  shopId            String    @id @map("shop_id") @db.Uuid
  isEnabled         Boolean   @default(false) @map("is_enabled")
  gstin             String?
  gstRateBp         Int       @default(0) @map("gst_rate_bp")
  fssai             String?
  upiUrl            String?   @map("upi_url")
  billFy            Int       @default(0) @map("bill_fy") @db.SmallInt
  billSeq           Int       @default(0) @map("bill_seq")
  version           BigInt    @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ordering_settings")
}

model MenuCategory {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  nameHi    String?  @map("name_hi")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items MenuItem[]

  @@index([shopId, sortOrder], map: "menu_categories_shop_idx")
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  nameHi      String?  @map("name_hi")
  pricePaise  Int      @map("price_paise")
  isVeg       Boolean  @default(true) @map("is_veg")
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([shopId, categoryId, sortOrder], map: "menu_items_shop_idx")
  @@map("menu_items")
}

model DiningTable {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  label       String
  publicToken String   @unique @map("public_token")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions TableSession[]

  @@unique([shopId, label])
  @@map("dining_tables")
}

model TableSession {
  id              String    @id @default(uuid()) @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  tableId         String    @map("table_id") @db.Uuid
  status          String    @default("OPEN")
  partySize       Int       @default(1) @map("party_size") @db.SmallInt
  guestName       String?   @map("guest_name")
  billFy          Int?      @map("bill_fy") @db.SmallInt
  billNo          Int?      @map("bill_no")
  subtotalPaise   Int       @default(0) @map("subtotal_paise")
  cgstPaise       Int       @default(0) @map("cgst_paise")
  sgstPaise       Int       @default(0) @map("sgst_paise")
  roundOffPaise   Int       @default(0) @map("round_off_paise")
  totalPaise      Int       @default(0) @map("total_paise")
  gstRateBp       Int       @default(0) @map("gst_rate_bp")
  paidMethod      String?   @map("paid_method")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(3)
  billRequestedAt DateTime? @map("bill_requested_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  table  DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([shopId, billFy, billNo])
  @@index([shopId, status, createdAt(sort: Desc)], map: "table_sessions_shop_idx")
  @@map("table_sessions")
}

model Order {
  id             String    @id @default(uuid()) @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  status         String    @default("RECEIVED")
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  note           String?
  servedAt       DateTime? @map("served_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@index([shopId, status, createdAt(sort: Desc)], map: "orders_shop_idx")
  @@index([sessionId], map: "orders_session_idx")
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  menuItemId String? @map("menu_item_id") @db.Uuid
  name       String
  pricePaise Int     @map("price_paise")
  isVeg      Boolean @map("is_veg")
  qty        Int     @db.SmallInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "order_items_order_idx")
  @@map("order_items")
}

model RestaurantStaff {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  name         String
  login        String    @unique
  passwordHash String    @map("password_hash")
  role         String
  isActive     Boolean   @default(true) @map("is_active")
  failedTries  Int       @default(0) @map("failed_tries")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions StaffSession[]

  @@index([shopId, role], map: "restaurant_staff_shop_idx")
  @@map("restaurant_staff")
}

model StaffSession {
  id        String   @id
  staffId   String   @map("staff_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  staff RestaurantStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId], map: "staff_sessions_staff_idx")
  @@map("staff_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  shopId     String?  @map("shop_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  shop Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([shopId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RestaurantPlan {
  id           String   @id
  name         String
  summary      String   @default("")
  monthlyPrice Int      @map("monthly_price")
  yearlyPrice  Int      @map("yearly_price")
  sortOrder    Int      @default(0) @map("sort_order")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("restaurant_plans")
}

model ShopPayment {
  id             String   @id @default(uuid()) @db.Uuid
  receiptNo      BigInt   @unique @default(autoincrement()) @map("receipt_no")
  shopId         String   @map("shop_id") @db.Uuid
  planId         String   @map("plan_id")
  planName       String   @map("plan_name")
  months         Int
  amount         Int
  method         String
  reference      String?
  idempotencyKey String   @unique @map("idempotency_key") @db.Uuid
  periodFrom     DateTime @map("period_from") @db.Timestamptz(3)
  periodTo       DateTime @map("period_to") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt(sort: Desc)], map: "shop_payments_shop_idx")
  @@map("shop_payments")
}
